<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>LiveLinguistWinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platform>x64</Platform>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <!-- Unpackaged, self-contained: no MSIX / cert needed to launch in CI -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.*" />
    <!-- On-device LLM (llama.cpp bindings). Native libs are loaded at runtime from
         the app directory (avoids WinUI's multi-variant native packaging collision);
         ship llama.dll + ggml*.dll from llama-cpp-build next to the exe. -->
    <PackageReference Include="LLamaSharp" Version="0.24.0" />
    <!-- Audio: WASAPI loopback capture (record what's playing — a Teams partner or a
         video — not the mic) + Whisper STT for French. NAudio is fully managed;
         Whisper.net.Runtime.Cpu carries the native whisper libs. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Whisper.net" Version="1.8.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.8.1" />
  </ItemGroup>

</Project>
