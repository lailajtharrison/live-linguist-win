<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LiveLinguistWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Shell" Background="#FF0B0D10" RequestedTheme="Dark">

    <!-- Caption box: a small always-on-top strip over Zoom/Teams/YouTube. Only the
         simplified French, large; the previous caption dimmed above it. -->
    <Grid x:Name="CaptionView" Visibility="Collapsed" Background="#FF0B0D10" Padding="20,10,12,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Spacing="4">
            <TextBlock Text="{x:Bind ViewModel.AudioWarning, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.HasAudioWarning, Mode=OneWay}"
                       FontSize="14" Foreground="#FFFBBF24" TextWrapping="Wrap" FontFamily="Segoe UI" />
            <TextBlock Text="{x:Bind ViewModel.PreviousSimplified, Mode=OneWay}" FontSize="18" LineHeight="24"
                       Foreground="#FF8B93A0" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                       FontFamily="Segoe UI" />
            <TextBlock Text="{x:Bind ViewModel.Simplified, Mode=OneWay}" FontSize="26" FontWeight="Bold"
                       LineHeight="34" Foreground="#FFF3F7FA" TextWrapping="Wrap" FontFamily="Segoe UI" />
            <TextBlock Text="{x:Bind ViewModel.Verbatim, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.ShowOriginal, Mode=OneWay}"
                       FontSize="14" FontStyle="Italic" Foreground="#FF9AA6B4" TextWrapping="Wrap"
                       MaxLines="2" TextTrimming="CharacterEllipsis" FontFamily="Segoe UI" />
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Top" Spacing="6" Margin="12,0,0,0">
            <Button x:Name="ExpandButton" Content="Expand" Click="OnExpandClick" FontSize="12"
                    ToolTipService.ToolTip="Back to the full window" />
            <ToggleButton x:Name="OriginalToggle" Content="Original" Click="OnOriginalToggleClick" FontSize="12"
                          ToolTipService.ToolTip="Also show the sentence as it was heard" />
        </StackPanel>
    </Grid>

    <!-- Main window: fills whatever size the student gives it. Header and status bar span
         the full width; the captions and input sit in one centred column. -->
    <Grid x:Name="RootGrid" Background="#FF0B0D10" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: name + language on the left; live status + caption box on the right -->
        <Border Grid.Row="0" Background="#FF0E1115" BorderBrush="#FF1C2129" BorderThickness="0,0,0,1"
                Padding="28,14">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                    <TextBlock Text="Live Linguist" FontSize="20" FontWeight="SemiBold"
                               Foreground="#FFEAF0F6" VerticalAlignment="Center" />
                    <Border Background="#FF1A1F26" BorderBrush="#FF2A3038" BorderThickness="1"
                            CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock Text="French · Easy-to-read (FALC)" FontSize="12" FontWeight="Medium"
                                   Foreground="#FFB8C0CC" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="16">
                    <!-- Live status: green dot while listening, grey otherwise -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="#FF34D399" VerticalAlignment="Center"
                                 Visibility="{x:Bind ViewModel.IsLive, Mode=OneWay}" />
                        <Ellipse Width="9" Height="9" Fill="#FF6B7480" VerticalAlignment="Center"
                                 Visibility="{x:Bind ViewModel.IsNotLive, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.Mode, Mode=OneWay}" FontSize="13"
                                   Foreground="#FFB8C0CC" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="CaptionButton" Click="OnCaptionModeClick" Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="A small window that stays on top of Zoom, Teams or YouTube">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                            <TextBlock Text="Caption box" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body: one centred column that scrolls if the window is short -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="1000" Margin="32,24,32,24" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Audio source: the mic (in person) vs the computer's sound (a Teams/Zoom
                     partner or a video, what a call actually needs). -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="20">
                    <TextBlock Text="Listen to" FontSize="14" Foreground="#FF9AA6B4" VerticalAlignment="Center" />
                    <RadioButton x:Name="SourceMic" GroupName="src" IsChecked="True" Checked="OnSourceChanged" MinWidth="0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE720;" FontSize="14" />
                            <TextBlock Text="Microphone" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="SourceLoopback" GroupName="src" Checked="OnSourceChanged" MinWidth="0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE767;" FontSize="14" />
                            <TextBlock Text="Meeting / video" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <Border Grid.Row="1" Background="#FF14181E" CornerRadius="12" Padding="32,22"
                        BorderBrush="#FF20262E" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="WHAT WAS SAID" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#FF9AA6B4" CharacterSpacing="120" />
                        <TextBlock Text="{x:Bind ViewModel.Verbatim, Mode=OneWay}" FontSize="20" LineHeight="30"
                                   Foreground="#FFDFE4EA" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </StackPanel>
                </Border>

                <!-- The caption is the point of the app: the biggest, brightest thing on screen -->
                <Border Grid.Row="2" Background="#FF0D1F18" CornerRadius="12" Padding="32,26" MinHeight="170"
                        BorderBrush="#FF244A40" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="EASY FRENCH · FALC" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#FF5EEAD4" CharacterSpacing="120" />
                        <TextBlock Text="{x:Bind ViewModel.Simplified, Mode=OneWay}" FontSize="34" FontWeight="Bold"
                                   LineHeight="46" Foreground="#FFF3F7FA" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />
                    </StackPanel>
                </Border>

                <!-- Notices: shown only when there is something to act on -->
                <StackPanel Grid.Row="3" Spacing="8">
                    <InfoBar IsOpen="{x:Bind ViewModel.HasAudioWarning, Mode=OneWay}" IsClosable="False"
                             Severity="Warning" Message="{x:Bind ViewModel.AudioWarning, Mode=OneWay}" />
                    <InfoBar IsOpen="{x:Bind ViewModel.HasHint, Mode=OneWay}" IsClosable="False"
                             Severity="{x:Bind ViewModel.HintSeverity, Mode=OneWay}"
                             Title="{x:Bind ViewModel.HintTitle, Mode=OneWay}"
                             Message="{x:Bind ViewModel.Hint, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#FF0A0C0F" BorderBrush="#FF1C2129" BorderThickness="0,1,0,0"
                Padding="28,10">
            <Grid>
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#FF8B93A0"
                           Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                           Foreground="#FF8B93A0" Text="{x:Bind ViewModel.Latency, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
    </Grid>
</Window>
