<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LiveLinguistWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Width="1280" Height="720" Background="#FF0B0D10" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="46" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Padding="28,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="14">
                <TextBlock Text="Live Linguist" FontSize="20" FontWeight="SemiBold"
                           Foreground="#FFEAF0F6" FontFamily="Segoe UI" />
                <Border Background="#FF1A1F26" BorderBrush="#FF2A3038" BorderThickness="1"
                        CornerRadius="14" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock Text="Français · FALC" FontSize="13" FontWeight="Medium"
                               Foreground="#FFB8C0CC" FontFamily="Segoe UI" />
                </Border>
                <!-- Audio source: the mic (in-person) vs the speakers (a Teams/Zoom
                     partner or a video — what a call actually needs). -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="14" Margin="8,0,0,0">
                    <RadioButton x:Name="SourceMic" GroupName="src" Content="🎤 Micro" IsChecked="True"
                                 Checked="OnSourceChanged" Foreground="#FFB8C0CC" FontSize="13" FontFamily="Segoe UI" />
                    <RadioButton x:Name="SourceLoopback" GroupName="src" Content="🔊 Réunion / vidéo"
                                 Checked="OnSourceChanged" Foreground="#FFB8C0CC" FontSize="13" FontFamily="Segoe UI" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Spacing="8">
                <Ellipse Width="10" Height="10" Fill="#FF7A8594" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.Mode, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                           Foreground="#FF9AA6B4" FontFamily="Segoe UI" VerticalAlignment="Center"
                           CharacterSpacing="40" />
            </StackPanel>
        </Grid>

        <!-- Body -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="1000" Width="1000" Spacing="16">
            <Border Background="#FF14181E" CornerRadius="14" Padding="36,26"
                    BorderBrush="#FF20262E" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="VOTRE TEXTE" FontSize="13" FontWeight="Bold"
                               Foreground="#FFB8C0CC" FontFamily="Segoe UI" CharacterSpacing="140" />
                    <TextBlock Text="{x:Bind ViewModel.Verbatim, Mode=OneWay}" FontSize="22" LineHeight="34"
                               Foreground="#FFDFE4EA" TextWrapping="Wrap" FontFamily="Segoe UI" />
                </StackPanel>
            </Border>
            <Border Background="#FF0D1F18" CornerRadius="14" Padding="36,30"
                    BorderBrush="#FF244A40" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="LANGAGE SIMPLE · FALC" FontSize="13" FontWeight="Bold"
                               Foreground="#FF5EEAD4" FontFamily="Segoe UI" CharacterSpacing="140" />
                    <TextBlock Text="{x:Bind ViewModel.Simplified, Mode=OneWay}" FontSize="34" FontWeight="Bold"
                               LineHeight="46" Foreground="#FFF3F7FA" TextWrapping="Wrap" FontFamily="Segoe UI" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Mic hint (self-explanatory: why demo, how to enable the mic) -->
        <Border Grid.Row="2" Margin="24,0,24,8" HorizontalAlignment="Center" MaxWidth="1000" Width="1000"
                Background="#1A5EEAD4" BorderBrush="#335EEAD4" BorderThickness="1" CornerRadius="10" Padding="16,10">
            <TextBlock Text="{x:Bind ViewModel.Hint, Mode=OneWay}" FontSize="14" LineHeight="21"
                       Foreground="#FFCFF3EA" TextWrapping="Wrap" FontFamily="Segoe UI" />
        </Border>

        <!-- Type-to-simplify (the obvious primary action) -->
        <StackPanel Grid.Row="3" Margin="24,0,24,16" HorizontalAlignment="Center" MaxWidth="1000" Width="1000" Spacing="6">
            <TextBlock Text="Écrivez ou collez du français, puis cliquez sur « Simplifier »"
                       FontSize="13" Foreground="#FF9AA6B4" FontFamily="Segoe UI" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox" Grid.Column="0" Height="48" FontSize="16"
                         PlaceholderText="Par exemple : « Il faudrait que vous soyez présent avant qu'il ne parte. »" />
                <Button Grid.Column="1" Margin="12,0,0,0" Height="48" Padding="22,0"
                        Content="Simplifier" Click="OnSimplifyClick" />
            </Grid>
        </StackPanel>

        <!-- Status bar -->
        <Border Grid.Row="4" Background="#FF0A0C0F" BorderBrush="#0FFFFFFF" BorderThickness="0,1,0,0">
            <Grid Padding="28,0">
                <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="#FF8B93A0"
                           FontFamily="Segoe UI" Text="Sur l'appareil · Qwen3-1.7B · rien ne quitte ce PC" />
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13"
                           Foreground="#FF8B93A0" FontFamily="Segoe UI"
                           Text="{x:Bind ViewModel.Latency, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Window>
