<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LiveLinguistWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Width="1280" Height="720" Background="#FF0B0D10">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="1.6*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Padding="28,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                <TextBlock Text="Live Linguist" FontSize="20" FontWeight="SemiBold"
                           Foreground="#FFEAF0F6" FontFamily="Segoe UI" />
                <Border Background="#1A5FD0C0" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                    <TextBlock Text="Deutsch · Leichte Sprache" FontSize="13"
                               Foreground="#FF7FE3D6" FontFamily="Segoe UI" />
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Spacing="8">
                <Ellipse Width="10" Height="10" Fill="#FFE5484D" VerticalAlignment="Center" />
                <TextBlock Text="Live" FontSize="14" Foreground="#FFE5484D"
                           FontFamily="Segoe UI" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Verbatim (what was heard) -->
        <Border Grid.Row="1" Margin="24,8,24,8" Background="#FF12151A" CornerRadius="14" Padding="28,20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="GEHÖRT" FontSize="12" FontWeight="SemiBold"
                           Foreground="#FF5D6B7A" FontFamily="Segoe UI" CharacterSpacing="120" />
                <TextBlock Margin="0,10,0,0" FontSize="22" LineHeight="32" Foreground="#FF95A1AF"
                           TextWrapping="Wrap" FontFamily="Segoe UI"
                           Text="Der Vorstand hat beschlossen, die Sitzung aufgrund der anhaltenden technischen Schwierigkeiten auf den folgenden Werktag zu verschieben." />
            </StackPanel>
        </Border>

        <!-- Simplified (easy language) -->
        <Border Grid.Row="2" Margin="24,8,24,8" Background="#FF0F1A18" CornerRadius="14"
                Padding="28,22" BorderBrush="#2A5FD0C0" BorderThickness="1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="EINFACHE SPRACHE" FontSize="12" FontWeight="SemiBold"
                           Foreground="#FF4FB3A6" FontFamily="Segoe UI" CharacterSpacing="120" />
                <TextBlock Margin="0,12,0,0" FontSize="34" FontWeight="SemiBold" LineHeight="46"
                           Foreground="#FFF3F7FA" TextWrapping="Wrap" FontFamily="Segoe UI"
                           Text="Die Sitzung ist heute nicht. Es gibt technische Probleme. Die Sitzung ist morgen." />
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Grid Grid.Row="3" Padding="28,0" Background="#FF0A0C0F">
            <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="#FF556070" FontFamily="Segoe UI"
                       Text="On-device · Qwen3-0.6B · nichts verlässt diesen PC" />
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13"
                       Foreground="#FF556070" FontFamily="Segoe UI" Text="Latenz ~1.2 s" />
        </Grid>
    </Grid>
</Window>
