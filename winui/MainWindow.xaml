<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LiveLinguistWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LiveLinguistWinUI.ViewModels">

    <Grid x:Name="Shell" Background="#FF0B0D10" RequestedTheme="Dark">

    <!-- Caption box: a small always-on-top strip over Zoom/Teams/YouTube. Only the
         simplified French, large; the previous caption dimmed above it. -->
    <Grid x:Name="CaptionView" Visibility="Collapsed" Background="#FF0B0D10" Padding="20,10,12,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Spacing="4">
            <TextBlock Text="{x:Bind ViewModel.AudioWarning, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.HasAudioWarning, Mode=OneWay}"
                       FontSize="14" Foreground="#FFFBBF24" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.WaitingTitle, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.IsWaiting, Mode=OneWay}"
                       FontSize="18" Foreground="#FF8B93A0" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.PreviousSimplified, Mode=OneWay}" FontSize="18" LineHeight="24"
                       Foreground="#FF8B93A0" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind ViewModel.Simplified, Mode=OneWay}" FontSize="26" FontWeight="Bold"
                       LineHeight="34" Foreground="#FFF3F7FA" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.Verbatim, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.ShowOriginal, Mode=OneWay}"
                       FontSize="14" FontStyle="Italic" Foreground="#FF9AA6B4" TextWrapping="Wrap"
                       MaxLines="2" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Top" Spacing="6" Margin="12,0,0,0">
            <Button x:Name="ExpandButton" Content="Expand" Click="OnExpandClick" FontSize="12"
                    ToolTipService.ToolTip="Back to the full window" />
            <ToggleButton x:Name="OriginalToggle" Content="Original" Click="OnOriginalToggleClick" FontSize="12"
                          ToolTipService.ToolTip="Also show the sentence as it was heard" />
        </StackPanel>
    </Grid>

    <!-- Main window: fills whatever size the student gives it. -->
    <Grid x:Name="RootGrid" Background="#FF0B0D10" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: name + language on the left; live status, help and caption box on the right -->
        <Border Grid.Row="0" Background="#FF0E1115" BorderBrush="#FF1C2129" BorderThickness="0,0,0,1"
                Padding="28,14">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                    <TextBlock Text="Live Linguist" FontSize="20" FontWeight="SemiBold"
                               Foreground="#FFEAF0F6" VerticalAlignment="Center" />
                    <Border Background="#FF1A1F26" BorderBrush="#FF2A3038" BorderThickness="1"
                            CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock Text="French · Easy-to-read (FALC)" FontSize="12" FontWeight="Medium"
                                   Foreground="#FFB8C0CC" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                    <!-- Live status: green dot while listening, grey otherwise -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Ellipse Width="9" Height="9" Fill="#FF34D399" VerticalAlignment="Center"
                                 Visibility="{x:Bind ViewModel.IsLive, Mode=OneWay}" />
                        <Ellipse Width="9" Height="9" Fill="#FF6B7480" VerticalAlignment="Center"
                                 Visibility="{x:Bind ViewModel.IsNotLive, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.Mode, Mode=OneWay}" FontSize="13"
                                   Foreground="#FFB8C0CC" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Click="OnHelpClick" ToolTipService.ToolTip="How to use Live Linguist"
                            AutomationProperties.Name="How to use Live Linguist">
                        <FontIcon Glyph="&#xE897;" FontSize="14" />
                    </Button>
                    <Button x:Name="CaptionButton" Click="OnCaptionModeClick" Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="A small window that stays on top of Zoom, Teams or YouTube">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                            <TextBlock Text="Caption box" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Welcome screen: first launch, or the ? button. Explains the three steps and
             asks where the French will come from. -->
        <ScrollViewer x:Name="OnboardingView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="780" Margin="32,36,32,32" Spacing="28">
                <StackPanel Spacing="10">
                    <TextBlock Text="Welcome to Live Linguist" FontSize="30" FontWeight="SemiBold"
                               Foreground="#FFF3F7FA" />
                    <TextBlock FontSize="16" LineHeight="24" Foreground="#FFB8C0CC" TextWrapping="Wrap"
                               Text="Live Linguist listens to French as it is spoken and shows it in easy-to-read French (FALC), so you can follow along. Everything stays on this computer." />
                </StackPanel>

                <StackPanel Spacing="14">
                    <TextBlock Text="HOW IT WORKS" FontSize="12" FontWeight="SemiBold" Foreground="#FF5EEAD4"
                               CharacterSpacing="120" />
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="15" Background="#FF123A33" VerticalAlignment="Top">
                            <TextBlock Text="1" FontWeight="SemiBold" Foreground="#FF5EEAD4"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Choose where the French comes from" FontSize="16" FontWeight="SemiBold"
                                       Foreground="#FFEAF0F6" />
                            <TextBlock Text="A call or video on this computer, or someone speaking in the room. Pick one below."
                                       FontSize="14" Foreground="#FF9AA6B4" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="15" Background="#FF123A33" VerticalAlignment="Top">
                            <TextBlock Text="2" FontWeight="SemiBold" Foreground="#FF5EEAD4"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Start your call, class or video" FontSize="16" FontWeight="SemiBold"
                                       Foreground="#FFEAF0F6" />
                            <TextBlock Text="Leave Live Linguist open. It starts captioning as soon as it hears French."
                                       FontSize="14" Foreground="#FF9AA6B4" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="15" Background="#FF123A33" VerticalAlignment="Top">
                            <TextBlock Text="3" FontWeight="SemiBold" Foreground="#FF5EEAD4"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Read the easy French" FontSize="16" FontWeight="SemiBold"
                                       Foreground="#FFEAF0F6" />
                            <TextBlock Text="Click “Caption box” (top right) to keep the captions in a small window on top of your call."
                                       FontSize="14" Foreground="#FF9AA6B4" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="14">
                    <TextBlock Text="WHERE WILL THE FRENCH COME FROM?" FontSize="12" FontWeight="SemiBold"
                               Foreground="#FF5EEAD4" CharacterSpacing="120" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ChooseLoopback" Grid.Column="0" Click="OnOnboardingChoice"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Padding="22,20">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <FontIcon Glyph="&#xE7F4;" FontSize="28" HorizontalAlignment="Left" Foreground="#FF5EEAD4" />
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="10"
                                            Background="#FF123A33" Padding="8,2">
                                        <TextBlock Text="Most common" FontSize="11" Foreground="#FF5EEAD4" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="A call or video on this computer" FontSize="16" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Teams, Zoom, YouTube, or any French playing on this PC."
                                           FontSize="13" Foreground="#FF9AA6B4" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ChooseMic" Grid.Column="1" Click="OnOnboardingChoice"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Padding="22,20">
                            <StackPanel Spacing="8">
                                <FontIcon Glyph="&#xE720;" FontSize="28" HorizontalAlignment="Left" Foreground="#FF5EEAD4" />
                                <TextBlock Text="Someone speaking in the room" FontSize="16" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Uses the microphone. Needs the French speech pack in Windows Settings."
                                           FontSize="13" Foreground="#FF9AA6B4" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="You can switch at any time. To see this guide again, click the ? button at the top."
                               FontSize="13" Foreground="#FF8B93A0" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Captioning view -->
        <Grid x:Name="MainView" Grid.Row="1" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Toolbar: where the audio comes from on the left; transcript tools on the right -->
            <Grid Grid.Row="0" Padding="28,12" ColumnSpacing="16" BorderBrush="#FF1C2129" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <TextBlock Text="Listen to" FontSize="14" Foreground="#FF9AA6B4" VerticalAlignment="Center" />
                    <RadioButton x:Name="SourceLoopback" GroupName="src" Checked="OnSourceChanged" MinWidth="0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7F4;" FontSize="14" />
                            <TextBlock Text="Call or video" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="SourceMic" GroupName="src" Checked="OnSourceChanged" MinWidth="0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE720;" FontSize="14" />
                            <TextBlock Text="Microphone" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <ToggleSwitch x:Name="ShowOriginalSwitch" OnContent="Show original" OffContent="Show original"
                                  MinWidth="0" Toggled="OnShowOriginalToggled"
                                  ToolTipService.ToolTip="Also show the French as it was said, under each caption" />
                    <Button x:Name="SaveButton" Click="OnSaveTranscriptClick" IsEnabled="False"
                            ToolTipService.ToolTip="Save everything captioned so far as a text file. Every session is also saved automatically in Documents\Live Linguist.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                            <TextBlock Text="Save transcript" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Before any French is heard: a quiet "listening" message, nothing else -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                        MaxWidth="520" Visibility="{x:Bind ViewModel.IsWaiting, Mode=OneWay}">
                <Border Width="64" Height="64" CornerRadius="32" Background="#FF123A33" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE7F0;" FontSize="28" Foreground="#FF5EEAD4" />
                </Border>
                <TextBlock Text="{x:Bind ViewModel.WaitingTitle, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"
                           Foreground="#FFEAF0F6" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.WaitingDetail, Mode=OneWay}" FontSize="14" LineHeight="21"
                           Foreground="#FF9AA6B4" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Once French is heard: the transcript. One line per caption, newest at the
                 bottom and largest; it follows the newest line unless the student scrolls up. -->
            <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.HasSpeech, Mode=OneWay}">
                <ScrollViewer x:Name="FeedScroll" VerticalScrollBarVisibility="Auto"
                              ViewChanged="OnFeedViewChanged">
                    <StackPanel MaxWidth="900" Margin="32,24,32,32" Spacing="22">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Entries}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="22" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:CaptionEntry">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind TimeText}" FontSize="12" Foreground="#FF6B7480"
                                                   Margin="0,6,0,0" />
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{x:Bind CaptionText, Mode=OneWay}"
                                                       FontSize="{x:Bind CaptionSize, Mode=OneWay}"
                                                       FontWeight="{x:Bind CaptionWeight, Mode=OneWay}"
                                                       Opacity="{x:Bind CaptionOpacity, Mode=OneWay}"
                                                       Foreground="#FFF3F7FA" TextWrapping="Wrap"
                                                       IsTextSelectionEnabled="True" />
                                            <TextBlock Text="{x:Bind Original}" FontSize="14" FontStyle="Italic"
                                                       Foreground="#FF8B93A0" TextWrapping="Wrap"
                                                       IsTextSelectionEnabled="True"
                                                       Visibility="{x:Bind ShowOriginal, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!-- Being heard right now: grey, until it becomes a caption line -->
                        <Grid ColumnSpacing="20" Visibility="{x:Bind ViewModel.HasLiveText, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE767;" FontSize="14" Foreground="#FF5EEAD4"
                                      HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.LiveText, Mode=OneWay}"
                                       FontSize="18" FontStyle="Italic" Foreground="#FF8B93A0" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Shown when the student has scrolled up to reread -->
                <Button x:Name="JumpToLatestButton" Visibility="Collapsed" Click="OnJumpToLatestClick"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                        Style="{StaticResource AccentButtonStyle}" CornerRadius="16" Padding="16,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74B;" FontSize="12" />
                        <TextBlock Text="Jump to latest" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Notices: shown only when there is something to act on -->
            <StackPanel Grid.Row="2" Spacing="8" MaxWidth="900" Margin="32,0,32,16">
                <InfoBar IsOpen="{x:Bind ViewModel.HasAudioWarning, Mode=OneWay}" IsClosable="False"
                         Severity="Warning" Message="{x:Bind ViewModel.AudioWarning, Mode=OneWay}" />
                <InfoBar IsOpen="{x:Bind ViewModel.HasHint, Mode=OneWay}" IsClosable="False"
                         Severity="{x:Bind ViewModel.HintSeverity, Mode=OneWay}"
                         Title="{x:Bind ViewModel.HintTitle, Mode=OneWay}"
                         Message="{x:Bind ViewModel.Hint, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#FF0A0C0F" BorderBrush="#FF1C2129" BorderThickness="0,1,0,0"
                Padding="28,10">
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                       Foreground="#FF8B93A0" Text="{x:Bind ViewModel.Latency, Mode=OneWay}" />
        </Border>
    </Grid>
    </Grid>
</Window>
